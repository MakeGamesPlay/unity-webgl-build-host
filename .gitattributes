# Normalize line endings; keep shell scripts LF so build.sh runs on macOS/Linux.
* text=auto eol=lf
*.cs   text eol=lf
*.go   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.meta text eol=lf
*.sh   text eol=lf
*.ps1  text eol=crlf

# Prebuilt native servers and compressed sample data are binary.
Editor/HostBuild/Bin~/** binary
*.wasm binary
*.br   binary
*.gz   binary
*.data binary
